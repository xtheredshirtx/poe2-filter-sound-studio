# Build artifacts (regenerated by build_exe.bat)
build/
dist/
*.spec

# Bundled binaries (too large for git; users provide their own or build script bundles)
ffmpeg/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Test / lint / type tooling caches and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# App-generated data (sits beside loaded filters, not under this folder, but ignore in case)
*_backups/
old sound files/

# Local tool config
.claude/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
*.swp
*.tmp
*.corrupt

# Logs
*.log
