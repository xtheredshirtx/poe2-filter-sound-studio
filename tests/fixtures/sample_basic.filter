# NeverSink-style sample filter (test fixture)
# [[1000]] Currency

Show # $type->currency $tier->t1
	Class "Currency"
	BaseType == "Divine Orb" "Mirror of Kalandra"
	SetFontSize 40
	SetTextColor 170 158 130 255
	PlayAlertSound 1 300
	MinimapIcon 0 Yellow Diamond

Show
	Class "Currency"
	BaseType "Orb of Transmutation"
	SetFontSize 30

# [[2000]] Chance Bases

Show
	Class "Rings" "Amulets"
	Rarity Normal
	BaseType "Sapphire Ring" "Stellar Amulet"
	SetTextColor 200 200 200 255

Show
	Class "Rings"
	Rarity Magic
	BaseType "Sapphire Ring"

# [[3000]] Waystones

Show
	Class "Waystones"
	WaystoneTier >= 15
	SetFontSize 38

# [[4000]] Hide junk

Hide
	Class "Currency"
	BaseType "Scroll of Wisdom"
