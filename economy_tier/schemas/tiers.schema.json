{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Economy Tier Data",
  "type": "object",
  "required": ["schema_version", "last_updated", "tiers"],
  "additionalProperties": true,
  "definitions": {
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "tierName": {
      "type": "string",
      "enum": ["SS", "S", "A", "B", "C", "D", "F", "SS_CHANCE_BASE"]
    },
    "entry": {
      "type": "object",
      "required": ["name", "tier", "confidence"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "match_type": { "type": "string" },
        "tier": { "$ref": "#/definitions/tierName" },
        "reason": { "type": "string" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entryList": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "game": { "type": "string" },
    "patch": { "type": "string" },
    "league": { "type": "string" },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notes": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "checked_at": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/entryList" }
    },
    "chance_bases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/entryList" }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "applies_to": { "type": "string" },
          "logic": { "type": "string" },
          "confidence": { "$ref": "#/definitions/confidence" }
        }
      }
    }
  }
}
